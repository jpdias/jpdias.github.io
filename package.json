{
  "name": "jpdias.github.io",
  "private": true,
  "license": "MIT",
  "scripts": {
    "update-deps": "node scripts/update-deps.cjs",
    "lint:frontmatter": "remark _posts/*.md index.md talks.md publications.md contact.md 404.md --frail",
    "build": "bundle exec jekyll build",
    "test:links": "bundle exec htmlproofer ./_site --disable-external --no-enforce-https --ignore-urls \"/photo\"",
    "validate": "npm run lint:frontmatter && npm run build && npm run test:links"
  },
  "dependencies": {
    "academicons": "1.9.5",
    "litelight-js": "1.2.0",
    "remixicon": "4.9.1"
  },
  "devDependencies": {
    "remark-cli": "^12.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-lint-frontmatter-schema": "^3.15.4"
  }
}
