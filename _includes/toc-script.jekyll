<script>
// Adds copyable deep links to page headings and article/presentation entries,
// and enhances the server-rendered "on this page" table of contents.
(function () {
  "use strict";

  function addCopyLinks() {
    // The copy-link styles live in css/main.css: the reserved space is part of
    // the first paint, so adding the buttons does not make the page reflow.
    function slugify(text) {
      return (text || "section")
        .normalize("NFKD")
        .replace(/[\u0300-\u036f]/g, "")
        .toLowerCase()
        .trim()
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-+|-+$/g, "") || "section";
    }

    function uniqueId(base) {
      var id = base;
      var suffix = 2;
      while (document.getElementById(id)) {
        id = base + "-" + suffix;
        suffix += 1;
      }
      return id;
    }

    function copyText(text) {
      if (navigator.clipboard && window.isSecureContext) {
        return navigator.clipboard.writeText(text);
      }
      return new Promise(function (resolve, reject) {
        var field = document.createElement("textarea");
        field.value = text;
        field.setAttribute("readonly", "");
        field.style.position = "fixed";
        field.style.opacity = "0";
        document.body.appendChild(field);
        field.select();
        var copied = false;
        try {
          copied = document.execCommand("copy");
        } catch (_error) {
          copied = false;
        }
        field.remove();
        if (copied) resolve();
        else reject(new Error("Copy failed"));
      });
    }

    function makeButton(target, label, permalink) {
      var button = document.createElement("button");
      button.type = "button";
      button.className = "copy-link-button";
      button.innerHTML = '<i class="ri-links-line" aria-hidden="true"></i>';
      button.setAttribute("aria-label", "Copy link to " + label);
      button.title = "Copy link";
      button.addEventListener("click", function () {
        var url = permalink || (window.location.origin + window.location.pathname + window.location.search + "#" + target.id);
        var originalLabel = button.getAttribute("aria-label");
        copyText(url).then(function () {
          button.innerHTML = '<i class="ri-check-line" aria-hidden="true"></i>';
          button.setAttribute("aria-label", "Link copied");
          button.title = "Copied!";
          window.setTimeout(function () {
            button.innerHTML = '<i class="ri-links-line" aria-hidden="true"></i>';
            button.setAttribute("aria-label", originalLabel);
            button.title = "Copy link";
          }, 1600);
        }).catch(function () {
          button.setAttribute("aria-label", "Could not copy link");
          button.title = "Could not copy link";
          window.setTimeout(function () {
            button.setAttribute("aria-label", originalLabel);
            button.title = "Copy link";
          }, 1600);
        });
      });
      target.appendChild(button);
      return button;
    }

    // Positions a heading button right after the heading text without putting
    // it back in the text flow, so it can never change the layout.
    function placeAtTextEnd(target, button) {
      if (!button) return;
      var last = null;
      var nodes = target.childNodes;
      for (var i = nodes.length - 1; i >= 0; i--) {
        var node = nodes[i];
        if (node === button) continue;
        if (node.nodeType === 3) {
          if (node.nodeValue && node.nodeValue.trim()) { last = node; break; }
        } else if (node.nodeType === 1 && node.textContent.trim()) {
          last = node;
          break;
        }
      }
      if (!last) { button.hidden = true; return; }
      var range = document.createRange();
      range.selectNodeContents(last);
      var rects = range.getClientRects();
      var rect = rects.length ? rects[rects.length - 1] : null;
      if (!rect) { button.hidden = true; return; }
      var targetRect = target.getBoundingClientRect();
      button.style.left = Math.round(rect.right - targetRect.left) + "px";
      button.style.top = Math.round(rect.top - targetRect.top) + "px";
      button.style.right = "auto";
      button.hidden = false;
    }

    var content = document.querySelector("main#content");
    if (!content) return;

    var placements = [];

    var headings = content.querySelectorAll("h1, h2, h3, h4, h5, h6");
    Array.prototype.forEach.call(headings, function (heading) {
      if (heading.closest(".social-links")) return;
      if (!heading.id) heading.id = uniqueId(slugify(heading.textContent));
      if (heading.querySelector(":scope > .copy-link-button")) return;
      heading.classList.add("copy-link-target");
      var button = makeButton(heading, heading.textContent.trim());
      placeAtTextEnd(heading, button);
      placements.push([heading, button]);
    });

    var articles = content.querySelectorAll(".posts > li");
    Array.prototype.forEach.call(articles, function (article) {
      var titleLink = article.querySelector("h2 a[href], h3 a[href], h4 a[href]");
      if (!titleLink) return;
      if (!article.id) article.id = uniqueId(slugify(titleLink.textContent));
      if (article.querySelector(":scope > .copy-link-button")) return;
      article.classList.add("copy-link-target", "copy-link-entry");
      makeButton(article, titleLink.textContent.trim(), new URL(titleLink.href, window.location.href).href);
    });

    var items = content.querySelectorAll(".pub-item, .talk-item, .post-item");
    Array.prototype.forEach.call(items, function (item) {
      if (!item.id) {
        var title = item.querySelector(".pub-title, .talk-title, h1, h2, h3, b, strong");
        item.id = uniqueId(slugify(title ? title.textContent : item.textContent));
      }
      if (item.querySelector(":scope > .copy-link-button")) return;
      item.classList.add("copy-link-target", "copy-link-entry");
      var title = item.querySelector(".pub-title, .talk-title, h1, h2, h3, b, strong");
      makeButton(item, title ? title.textContent.trim() : "this entry");
    });

    // The text metrics change once the web fonts load, so the buttons are
    // placed again afterwards.
    function reposition() {
      placements.forEach(function (placement) {
        placeAtTextEnd(placement[0], placement[1]);
      });
    }
    window.addEventListener("load", reposition);
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(reposition);
    }
  }

  addCopyLinks();

  var toc = document.getElementById("page-toc");
  if (!toc) return;

  var container = document.querySelector(".blog-content");
  if (!container) return;

  var inner = toc.querySelector(".toc-inner");
  var links = toc.querySelectorAll(".toc-item a");
  if (links.length < 2) return;

  var entries = [];
  Array.prototype.forEach.call(links, function (link) {
    var href = link.getAttribute("href") || "";
    if (href.charAt(0) !== "#") return;
    var heading = document.getElementById(href.slice(1));
    if (!heading) return;
    entries.push({ heading: heading, link: link });
  });
  if (entries.length < 2) return;

  var first = entries[0].link;
  if (!first.classList.contains("active")) {
    first.classList.add("active");
    first.parentNode.classList.add("active");
  }

  var TOC_BASE_TOP = 170;

  function placeToc() {
    if (toc.getClientRects().length === 0) return;
    var h1 = container.querySelector("h1");
    if (!h1) return;
    var lh = parseFloat(getComputedStyle(h1).lineHeight) || 28.8;
    var lines = Math.max(1, Math.round(h1.getBoundingClientRect().height / lh));
    var top = Math.round(TOC_BASE_TOP + (lines - 1) * lh);
    var maxH = Math.max(160, window.innerHeight - top - 32);
    toc.style.top = top + "px";
    toc.style.maxHeight = maxH + "px";
    if (inner) inner.style.maxHeight = maxH + "px";
  }
  placeToc();
  window.addEventListener("resize", placeToc);
  window.addEventListener("load", placeToc);
  if (document.fonts && document.fonts.ready) {
    document.fonts.ready.then(placeToc);
  }

  function setActive(id) {
    entries.forEach(function (entry) {
      var on = entry.link.getAttribute("href") === "#" + id;
      entry.link.classList.toggle("active", on);
      entry.link.parentNode.classList.toggle("active", on);
    });
  }

  if ("IntersectionObserver" in window) {
    var visible = {};
    var observer = new IntersectionObserver(
      function (observed) {
        observed.forEach(function (entry) {
          if (entry.isIntersecting) {
            delete visible[entry.target.id];
          } else {
            visible[entry.target.id] = true;
          }
        });
        for (var i = 0; i < entries.length; i++) {
          var id = entries[i].heading.id;
          if (!visible[id]) {
            setActive(id);
            return;
          }
        }
      },
      { rootMargin: "0px 0px -30% 0px", threshold: 0 }
    );
    entries.forEach(function (entry) {
      observer.observe(entry.heading);
    });
  }
})();
</script>
