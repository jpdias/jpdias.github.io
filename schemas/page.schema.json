{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Page front matter",
  "type": "object",
  "properties": {
    "layout": {
      "enum": ["default", "page-with-toc"]
    },
    "head_title": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150
    },
    "description": {
      "type": "string",
      "minLength": 50,
      "maxLength": 200
    },
    "image": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^/images/"
        },
        {
          "type": "object",
          "required": ["path"],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/images/"
            },
            "width": {
              "type": "integer"
            },
            "height": {
              "type": "integer"
            },
            "alt": {
              "type": "string"
            }
          }
        }
      ]
    }
  },
  "required": ["layout", "title", "description"]
}
