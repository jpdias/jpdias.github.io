<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="theme-color" content="#5f899a" />
    <meta name="keywords" content="blog, accent, {{ site.author.name | default: site.author }}, {{ site.title }}, jekyll"/>
    <meta http-equiv="Permissions-Policy" content="interest-cohort=()"/>

    {% assign head_title = page.head_title | default: page.title | default: site.title %}
    {% if paginator and paginator.page > 1 %}
        {% assign head_title = head_title | append: " (page " | append: paginator.page | append: ")" %}
    {% endif %}
    <title>{{ head_title }}</title>

    {% comment %}
      jekyll-seo-tag emits the description, canonical URL, Open Graph,
      Twitter Card and JSON-LD metadata. `title=false` keeps our own tab
      title above, while og:title/twitter:title still come from page.title.
    {% endcomment %}
    {% seo title=false %}
    {% if site.logo %}
    <meta property="og:logo" content="{{ site.logo | absolute_url }}" />
    {% endif %}

    <link rel="alternate" type="application/rss+xml" title="{{ site.title }} RSS" href="/feed.xml" />
    {% comment %} Relative link so HTMLProofer can verify the share image exists. {% endcomment %}
    {% assign share_image = page.image.path | default: page.image | default: site.default_og_image %}
    <link rel="image_src" href="{{ site.baseurl }}{{ share_image }}">
    <link rel="preload" href="{{ site.baseurl }}/fonts/IBMPlexMono-Regular.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ site.baseurl }}/fonts/lato-v17-latin-300.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ site.baseurl }}/fonts/remixicon.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="{{ site.baseurl }}/css/main.css">
    <link rel="stylesheet" href="{{ site.baseurl }}/css/code.css">
    <link rel="stylesheet" href="{{ site.baseurl }}/css/academicons.css">
    <link rel="stylesheet" href="{{ site.baseurl }}/css/remixicon.css">
    {% if page.layout == "post" %}
    <link rel="stylesheet" href="{{ site.baseurl }}/css/lite-light.min.css">
    {% endif %}
    <link rel="icon" type="image/svg+xml" href="{{ site.baseurl }}/images/favicon/favicon.svg" sizes="any">
    <link rel="icon" href="{{ site.baseurl }}/images/favicon/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="{{ site.baseurl }}/images/favicon/favicon-32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="{{ site.baseurl }}/images/favicon/favicon-16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ site.baseurl }}/images/favicon/apple-touch-icon.png">
</head>
<body>
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="wrapper">
        <header>
            <nav aria-label="Main">
                <a id="author-name" href="/">./jpdias</a>
                <ul id="navlist" class="navbar-ul">
                    {% for page in site.nav %}
                        {% if page.name contains "↗" %}
                            <li class="nav-list"><a href="{{ page.link }}"><span aria-hidden="true">/{{ page.name }}</span><span class="visually-hidden">/{{ page.name | remove: " ↗" }} (opens in new tab)</span></a></li>
                        {% elsif page.name == "Resume" %}
                            <li class="nav-list"><a target="_blank" href="{{ page.link }}">/{{ page.name }}</a></li>
                        {% else %}
                            <li class="nav-list"><a href="{{ page.link }}">/{{ page.name }}</a></li>
                        {% endif %}
                    {% endfor %}
                </ul>
            </nav>
        </header>
        <hr>
        <main id="content" class="{% if page.is_contact == true %}container content contact{% else %}container content{% endif %}">
            {{ content }}
            <p class="social-links">
                {% for page in site.social %}
                <span><a rel="me" href="{{ page.url }}" target="_blank" aria-label="{{ page.name }}"><i class="{{ page.icon }}" aria-hidden="true"></i></a></span> &nbsp;
                {% endfor %}
            </p>
        </main>
    </div>

    {% include toc-script.jekyll %}

    <script>
      (function () {
        var tables = document.querySelectorAll("table");
        function update() {
          tables.forEach(function (t) {
            var remaining = t.scrollWidth - t.clientWidth - t.scrollLeft;
            t.toggleAttribute("data-overflow", remaining > 8);
            // make horizontally scrollable tables reachable/scrollable via keyboard
            if (t.scrollWidth - t.clientWidth > 8) {
              if (!t.hasAttribute("tabindex")) {
                t.setAttribute("tabindex", "0");
                t.setAttribute("aria-label", (t.querySelector("caption") || {}).textContent || "Table, scrolls horizontally");
              }
            }
          });
        }
        update();
        addEventListener("resize", update, { passive: true });
        tables.forEach(function (t) {
          t.addEventListener("scroll", update, { passive: true });
        });
      })();
    </script>

</body>
